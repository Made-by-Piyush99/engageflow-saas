# =============================================================================
# ENGAGEFLOW ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and insert your real Meta / Threads API credentials
# =============================================================================

# Meta Instagram Graph API Credentials (developers.facebook.com)
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_CONFIG_ID=your_meta_config_id_here

# Threads API Credentials (Optional)
THREADS_APP_ID=your_threads_app_id_here
THREADS_APP_SECRET=your_threads_app_secret_here

# Webhook Security
WEBHOOK_VERIFY_TOKEN=engageflow_webhook_verify_token_2026

# Server Port
PORT=5050
